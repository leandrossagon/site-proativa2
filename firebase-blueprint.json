{
  "projectID": "gen-lang-client-0726244924",
  "auth": {
    "providers": ["google"],
    "roles": ["admin"]
  },
  "firestore": {
    "collections": [
      {
        "name": "leads",
        "description": "Leads captured from the application.",
        "rules": [
          {
            "allow": "read",
            "condition": "true"
          },
          {
            "allow": "create",
            "condition": "true"
          },
          {
            "allow": "update",
            "condition": "true"
          },
          {
            "allow": "delete",
            "condition": "true"
          }
        ],
        "schema": {
          "nome": "string",
          "empresa": "string",
          "whatsapp": "string",
          "email": "string",
          "setor": "string",
          "detalhes": "string",
          "porteProjeto": "string",
          "status": "string",
          "notes": "string",
          "createdAt": "timestamp"
        }
      },
      {
        "name": "settings",
        "description": "Application settings.",
        "rules": [
          {
            "allow": "read",
            "condition": "true"
          },
          {
            "allow": "write",
            "condition": "true"
          }
        ],
        "schema": {
          "email": "string",
          "whatsapp": "string",
          "phone": "string",
          "address": "string",
          "cnpj": "string"
        }
      }
    ]
  }
}
